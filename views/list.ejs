<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task List</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <%- include('navbar') %>

    <div class="container">
      <h1>Task Listing Page</h1>
      <form action="/multi-delete" method="post">
        <button type="submit" class="delete-items"> Delete Selected Tasks</button>
        <div class="task-list">
          <ol>

            <% for(let i=0; i < result.length; i++) { %>
              <li>

                <div class="task-card">
                  <div class="task-info">

                    <h3>
                      <%= result[i].title %>
                    </h3>
                    <p>
                      <%= result[i].description %>
                    </p>

                    <input type="checkbox" name="selectedTasks" value="<%= result[i]._id %>">
                    <a href="/delete/<%=result[i]._id%>" class="delete-item">Delete</a>

                    <a href="/update/<%=result[i]._id%>" class="update-item">Update</a>

                  </div>
                </div>
              </li>
              <% } %>
          </ol>
        </div>

      </form>
    </div>
</body>

</html>