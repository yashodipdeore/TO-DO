<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task List</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <%- include('navbar') %>

    <div class="container">
      <h1>Task Listing Page</h1>

      <div class="task-list">
        <% for(let i=0; i < result.length; i++) { %>
          <div class="task-card">
            <div class="task-info">
              <h3>
                <%= result[i].title %>
              </h3>
              <p>
                <%= result[i].description %>
              </p>
              <a href="/delete/<%=result[i]._id%>" class="delete-item">Delete</a>
            </div>
          </div>
          <% } %>
      </div>

    </div>
</body>

</html>